{
  "name": "zk-mc3-panel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ZK-MC3-PANEL \u2014 A modern Minecraft server hosting panel by ZK-STUDIO",
  "author": "ZK-STUDIO \u2014 MD Ziyan Hossain",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build && npm run build:daemon",
    "start": "node dist/server.cjs",
    "createuser": "tsx scripts/createuser.ts",
    "typecheck": "tsc --noEmit",
    "check:shell": "bash scripts/check-shell.sh",
    "clean": "rm -rf dist",
    "qa:render": "npm run build && node qa-render.mjs",
    "qa:password": "node qa-password.mjs",
    "build:daemon": "node scripts/build-daemon.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.2.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/archiver": "^6.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
