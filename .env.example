# ---------------------------------------------------------------
# ZK-MC3-PANEL — example environment
# Copy to .env and fill in your own secrets.
# ---------------------------------------------------------------

NODE_ENV=production
PORT=31120

# Session signing secret — generate with: openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# First-run owner account (only used when the user database is empty)
OWNER_USERNAME=admin
OWNER_PASSWORD=admin123
OWNER_EMAIL=admin@gmail.com

# Optional: pin a specific java binary
# JAVA_BIN=/usr/lib/jvm/java-21-openjdk-amd64/bin/java

# Seed demo users/servers on first boot (false for production)
SEED_DEMO=true

# Node agent (used by agent/agent.js on remote nodes)
# ZK_PANEL_TOKEN=generate-with-openssl-rand-hex-24
# ZK_AGENT_NAME=Node EU-1
# ZK_AGENT_PUBLIC_IP=203.0.113.10
